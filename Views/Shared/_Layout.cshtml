<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 shadow-sm">
        <div class="container">

            <a class="navbar-brand fw-bold fs-4" href="/Car/Index">🚗 Car Rental</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#myMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="myMenu">
                <ul class="navbar-nav ms-auto gap-2">
                    <li class="nav-item">
                        <a class="nav-link active rounded px-3" style="background-color: rgba(255,255,255,0.1);" href="/Car/Index">Available Cars</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active rounded px-3" style="background-color: rgba(255,255,255,0.1);" href="/Car/Booked">Booked Cars</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-5 flex-grow-1">
        <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border">

            @RenderBody()

        </div>
    </div>

    <footer class="bg-dark text-white-50 text-center py-4 mt-auto">
        <div class="container">
            <p class="mb-0">&copy; 2026 - Premium Car Rental. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>