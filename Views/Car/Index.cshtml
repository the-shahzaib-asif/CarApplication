@model List<WebApplication2.Models.Car>

<h2 class="text-primary">Available Cars</h2>
<p class="text-muted">For booking select the car from the list.</p>


@if (Model == null || Model.Count == 0)
{

    <div class="alert alert-info" role="alert">
        No cars are available for booking!
    </div>
}
else
{

    <div class="row">


        @foreach (var car in Model)
        {

            <div class="col-12 col-md-4 mb-4">



                <div class="card shadow-sm h-100">
                    <div class="card-body">


                        <h4 class="card-title fw-bold">
                            @car.Name
                            <span class="badge bg-success float-end">Available</span>
                        </h4>


                        <p class="card-text text-danger fw-bold mb-4">PKR @car.PricePerDay / day</p>


                        <form action="/Car/Book" method="post">

                            <input type="hidden" name="id" value="@car.Id" />


                            <button type="submit" class="btn btn-primary w-100">Book Car</button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
}